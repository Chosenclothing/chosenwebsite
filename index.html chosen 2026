<script>
/* ═══ CHOSEN — premium interactions ═══ */
(function () {
  'use strict';

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var RAD = Math.PI / 180;

  /* ───────── 3D product viewers ───────── */
  var viewers = [];

  function Viewer(root) {
    var stage = root.querySelector('.viewer-stage');
    var obj = root.querySelector('.viewer-obj');
    var floor = root.querySelector('.viewer-floor');
    var flipBtn = root.querySelector('.viewer-flip');
    var entrance = root.getAttribute('data-entrance');

    var s = {
      y: 0, target: 0, vy: 0,          // spin (degrees) + coasting velocity
      tx: 0, ty: 0, ttx: 0, tty: 0,    // hover tilt (current / target)
      drag: false, coast: false, hover: false,
      lastX: 0, visible: false, entered: false,
      t: Math.random() * 6
    };
    this.s = s;
    this.root = root;

    /* turning in: heroes swing round on load, shop items swing round as they scroll into view */
    if (!reduce) {
      if (entrance === 'hero') { s.y = s.target = -140; }
      if (entrance === 'scroll') { s.y = s.target = -75; }
    }

    var self = this;

    function markUsed() { root.classList.add('used'); }

    stage.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      s.drag = true; s.coast = false; s.vy = 0; s.lastX = e.clientX;
      stage.classList.add('dragging');
      markUsed();
      try { stage.setPointerCapture(e.pointerId); } catch (_) {}
    });

    stage.addEventListener('pointermove', function (e) {
      if (s.drag) {
        var d = (e.clientX - s.lastX) * 0.5;
        s.lastX = e.clientX;
        s.target += d; s.y = s.target;
        s.vy = s.vy * 0.6 + d * 0.4;
      } else if (e.pointerType === 'mouse') {
        var r = stage.getBoundingClientRect();
        var nx = (e.clientX - r.left) / r.width - 0.5;
        var ny = (e.clientY - r.top) / r.height - 0.5;
        s.ttx = -ny * 9; s.tty = nx * 10; s.hover = true;
      }
    });

    function release() {
      if (!s.drag) return;
      s.drag = false; s.coast = true;
      stage.classList.remove('dragging');
    }
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
    stage.addEventListener('pointerleave', function () { s.ttx = 0; s.tty = 0; s.hover = false; });

    function flip() {
      markUsed();
      s.vy = 0; s.coast = false;
      s.target = (Math.round(s.target / 180) + 1) * 180;
    }
    this.flip = flip;
    if (flipBtn) flipBtn.addEventListener('click', flip);
    stage.addEventListener('dblclick', flip);
    stage.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault(); flip();
      }
    });

    /* a full turn to show off a newly picked color */
    this.spin = function () {
      s.vy = 0; s.coast = false;
      s.target = Math.round(s.target / 180) * 180 + 360;
    };

    this.update = function (dt) {
      s.t += dt;
      if (!s.drag) {
        if (s.coast) {
          s.target += s.vy; s.vy *= 0.93;
          if (Math.abs(s.vy) < 0.25) {            // settle on the nearest face
            s.coast = false;
            s.target = Math.round(s.target / 180) * 180;
          }
        }
        s.y += (s.target - s.y) * (s.coast ? 0.4 : 0.11);
      }
      s.tx += (s.ttx - s.tx) * 0.08;
      s.ty += (s.tty - s.ty) * 0.08;

      var idle = !(reduce || s.hover || s.drag);
      var swayY = idle ? Math.sin(s.t * 0.9) * 4.5 : 0;
      var swayX = idle ? Math.cos(s.t * 0.7) * 1.6 : 0;
      var ry = s.y + s.ty + swayY;

      obj.style.transform = 'rotateX(' + (s.tx + swayX).toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg)';

      var edge = Math.abs(Math.sin(ry * RAD));
      obj.style.setProperty('--shade', (edge * 0.5).toFixed(3));
      obj.style.setProperty('--sx', (50 + Math.sin(ry * RAD + 0.6) * 70).toFixed(1) + '%');
      if (floor) {
        floor.style.transform = 'scaleX(' + (1 - 0.45 * edge).toFixed(3) + ')';
        floor.style.opacity = (0.9 - 0.4 * edge).toFixed(3);
      }
    };

    /* only animate what's on screen */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          s.visible = en.isIntersecting;
          if (en.isIntersecting && !s.entered) {
            s.entered = true;
            if (entrance === 'hero') { setTimeout(function () { s.target = 0; }, 650); }
            else if (entrance === 'scroll') { s.target = 0; }
          }
        });
      }, { threshold: 0.3 }).observe(root);
    } else {
      s.visible = true; s.entered = true; s.target = 0;
    }

    root._viewer = this;
    viewers.push(this);
  }

  document.querySelectorAll('[data-viewer]').forEach(function (el) { new Viewer(el); });

  var last = performance.now();
  function frame(now) {
    var dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    for (var i = 0; i < viewers.length; i++) {
      if (viewers[i].s.visible) viewers[i].update(dt);
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  /* ───────── color swatches: swap photos, label, checkout link ───────── */
  document.addEventListener('click', function (e) {
    var dot = e.target.closest ? e.target.closest('.color-dot') : null;
    if (!dot) return;
    var card = dot.closest('[data-product]');
    if (!card) return;
    var id = card.getAttribute('data-product');
    var name = card.getAttribute('data-name');
    var color = dot.getAttribute('data-color');

    card.querySelectorAll('.color-dot').forEach(function (d) {
      d.classList.remove('active'); d.setAttribute('aria-pressed', 'false');
    });
    dot.classList.add('active'); dot.setAttribute('aria-pressed', 'true');

    var f = document.getElementById(id + '-front');
    var b = document.getElementById(id + '-back');
    f.src = dot.getAttribute('data-front'); f.alt = name + ' in ' + color + ', front';
    b.src = dot.getAttribute('data-back');  b.alt = name + ' in ' + color + ', back';
    document.getElementById(id + '-color').textContent = color;
    document.getElementById(id + '-buy').href = dot.getAttribute('data-link');

    var vEl = card.querySelector('.viewer');
    if (vEl && vEl._viewer && !reduce) vEl._viewer.spin();
  });

  /* warm the cache so color swaps don't flicker */
  window.addEventListener('load', function () {
    document.querySelectorAll('.color-dot').forEach(function (d) {
      new Image().src = d.getAttribute('data-front');
      new Image().src = d.getAttribute('data-back');
    });
  });

  /* ───────── scroll: nav, parallax, reveals ───────── */
  var nav = document.getElementById('nav');
  var hero = document.getElementById('home');
  var heroCross = hero.querySelector('.hero-cross');
  var heroStage = hero.querySelector('.hero-stage');
  var ticking = false;

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      var y = window.scrollY;
      nav.classList.toggle('scrolled', y > 40);
      if (!reduce && y < window.innerHeight * 1.3) {
        heroCross.style.transform = 'translateY(calc(-50% + ' + (y * 0.18).toFixed(1) + 'px))';
        heroStage.style.transform = 'translateY(' + (y * -0.06).toFixed(1) + 'px)';
      }
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* soft light that follows the cursor across the hero */
  if (!reduce && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', function (e) {
      var r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      hero.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  }

  /* reveal headings + product details as they arrive */
  var revealTargets = document.querySelectorAll('.reveal, .showcase');
  if ('IntersectionObserver' in window) {
    var ro = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { en.target.classList.add('in'); ro.unobserve(en.target); }
      });
    }, { threshold: 0.2 });
    revealTargets.forEach(function (el) { ro.observe(el); });
  } else {
    revealTargets.forEach(function (el) { el.classList.add('in'); });
  }
})();

</script>
