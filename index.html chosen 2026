  }
  .spill:hover,.spill.active{border-color:var(--gold);background:rgba(184,137,42,.12);color:var(--gold);}
  @keyframes spin{to{transform:rotate(360deg);}}
  @media(max-width:780px){.studio-grid{grid-template-columns:1fr!important;}}
  #actionBtns{display:flex;}
</style>

<script>
  let selectedStyle = 'Bold Streetwear';
  let currentDesignUrl = '';
  let currentVerse = '';

  function selectStyle(el, style) {
    document.querySelectorAll('.spill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    selectedStyle = style;
  }

  async function generateDesign() {
    const verse = document.getElementById('verseInput').value.trim();
    if (!verse) {
      document.getElementById('verseInput').style.borderColor = 'var(--rust)';
      document.getElementById('verseInput').placeholder = '⚠ Please enter a verse first...';
      setTimeout(() => {
        document.getElementById('verseInput').style.borderColor = 'rgba(184,137,42,.25)';
        document.getElementById('verseInput').placeholder = 'e.g. "I can do all things through Christ who strengthens me" — Philippians 4:13';
      }, 2500);
      return;
    }

    currentVerse = verse;
    const garment = document.getElementById('garmentSelect').value;
    const color = document.getElementById('colorSelect').value;

    // Update shirt color
    const shirtColors = { 'Black':'#111','White':'#f5f0e8','Charcoal Grey':'#3a3a3a','Cream':'#e8e0d0','Navy':'#1a2340' };
    document.getElementById('shirtPath').setAttribute('fill', shirtColors[color] || '#1a1a1a');

    // Show loading
    document.getElementById('emptyState').style.display = 'none';
    document.getElementById('resultState').style.display = 'none';
    document.getElementById('loadingState').style.display = 'flex';
    document.getElementById('actionBtns').style.display = 'none';
    document.getElementById('loadingVerse').textContent = '"' + verse.substring(0,60) + (verse.length>60?'…':'"');

    const btn = document.getElementById('generateBtn');
    btn.disabled = true;
    document.getElementById('btnSpinner').style.display = 'block';
    document.getElementById('btnLabel').textContent = 'Creating…';

    try {
      // Call Claude to generate a detailed image prompt
      const promptRes = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 300,
          messages: [{
            role: "user",
            content: `You are a creative director for a Christian streetwear clothing brand called CHOSEN.
A customer wants a custom t-shirt design based on this verse: "${verse}"
Style preference: ${selectedStyle}
Garment: ${garment} (${color})

Write a concise image generation prompt (under 120 words) for creating a graphic design to be printed on the front of this ${garment}. 
The design should be a striking graphic — NOT a photo of a person or shirt. Think: symbolic, typographic, or illustrated artwork suitable for screen printing.
Focus on: visual symbols related to the verse, the scripture text styled beautifully, faith-based imagery (cross, light, dove, crown, etc.), consistent with ${selectedStyle} aesthetic.
Return ONLY the image prompt, nothing else.`
          }]
        })
      });

      const promptData = await promptRes.json();
      const imagePrompt = promptData.content?.[0]?.text?.trim() || `Christian streetwear graphic design for "${verse}", ${selectedStyle} style, bold typography, cross imagery, golden tones on dark background, screen print art`;

      // Use Claude to generate an SVG/canvas-based design description we render ourselves
      // Since we can't call image generation APIs, we'll use Claude to create an SVG design
      const svgRes = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 2000,
          messages: [{
            role: "user",
            content: `Create a beautiful SVG graphic design for a Christian ${garment} based on this verse: "${verse}"
Style: ${selectedStyle}
Shirt color: ${color}

Requirements:
- Output ONLY a raw SVG element (starting with <svg and ending with </svg>), no other text
- viewBox="0 0 300 300"
- Transparent background (no rect fill covering the whole thing)
- Include: stylized verse text or key words, a symbolic faith icon (cross, dove, rays of light, crown of thorns, anchor, etc.)
- Use colors that look great on a ${color} shirt: golds (#B8892A, #D4AA50), whites (#FAF8F4), warm creams, deep shadows
- Make it look like a real screen-print graphic — bold, iconic, wearable
- ${selectedStyle === 'Minimalist' ? 'Keep it clean and simple with minimal elements' : ''}
- ${selectedStyle === 'Bold Streetwear' ? 'Make it bold, graphic, high contrast like a streetwear drop' : ''}
- ${selectedStyle === 'Vintage Gospel' ? 'Use distressed textures, vintage feel, classic church aesthetic' : ''}
- ${selectedStyle === 'Watercolor' ? 'Use soft, flowing shapes suggesting watercolor washes' : ''}
- ${selectedStyle === 'Hand Lettered' ? 'Feature the text prominently with a hand-lettered feel' : ''}
- ${selectedStyle === 'Dark & Dramatic' ? 'Use dramatic contrasts, bold imagery, powerful feel' : ''}
SVG only:`
          }]
        })
      });

      const svgData = await svgRes.json();
      let svgContent = svgData.content?.[0]?.text?.trim() || '';

      // Clean up the SVG
      svgContent = svgContent.replace(/```svg|```xml|```/g, '').trim();
      if (!svgContent.startsWith('<svg')) {
        const idx = svgContent.indexOf('<svg');
        if (idx !== -1) svgContent = svgContent.substring(idx);
      }
      const endIdx = svgContent.lastIndexOf('</svg>');
      if (endIdx !== -1) svgContent = svgContent.substring(0, endIdx + 6);

      // Convert SVG to data URL
      const blob = new Blob([svgContent], { type: 'image/svg+xml' });
      const url = URL.createObjectURL(blob);
      currentDesignUrl = url;

      // Show result
      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('resultState').style.display = 'flex';
      document.getElementById('designImg').src = url;
      document.getElementById('resultVerse').textContent = '"' + verse.substring(0,80) + (verse.length>80?'…':'"');
      document.getElementById('resultMeta').textContent = selectedStyle + ' · ' + color + ' ' + garment;
      document.getElementById('actionBtns').style.display = 'flex';

    } catch (err) {
      console.error(err);
      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('emptyState').style.display = 'flex';
      document.getElementById('emptyState').innerHTML = '<div style="font-size:2rem;opacity:.4;">⚠</div><p style="font-size:.85rem;color:var(--stone);max-width:200px;line-height:1.75;">Something went wrong. Please try again in a moment.</p>';
    }

    btn.disabled = false;
    document.getElementById('btnSpinner').style.display = 'none';
    document.getElementById('btnLabel').textContent = '+ Generate My Design';
  }

  function regenerate() {
    document.getElementById('resultState').style.display = 'none';
    document.getElementById('actionBtns').style.display = 'none';
    document.getElementById('emptyState').style.display = 'flex';
    generateDesign();
  }

  function openOrderModal() {
    const modal = document.getElementById('orderModal');
    modal.style.display = 'flex';
    document.getElementById('modalThumb').src = currentDesignUrl;
    const v = currentVerse;
    document.getElementById('modalVerseLabel').textContent = '"' + v.substring(0,70) + (v.length>70?'…':'"');
  }

  function closeOrderModal() {
    document.getElementById('orderModal').style.display = 'none';
    document.getElementById('modalForm').style.display = 'block';
    document.getElementById('modalSuccess').style.display = 'none';
  }

  function submitOrder() {
    const firstName = document.getElementById("oFirstName").value.trim();
    const lastName = document.getElementById("oLastName").value.trim();
    const email = document.getElementById("oEmail").value.trim();
    const address = document.getElementById("oAddress").value.trim();
    const size = document.getElementById("oSize").value;
    const qty = document.getElementById("oQty").value;
    const garment = document.getElementById("garmentSelect").value;
    const color = document.getElementById("colorSelect").value;

    if (!firstName || !email || !address) {
      alert("Please fill in your name, email, and address to continue.");
      return;
    }

    // ✏️  Replace with your real Stripe Payment Link URL
    const STRIPE_LINK = "https://buy.stripe.com/YOUR_STRIPE_PAYMENT_LINK";

    const orderDetails = {
      name: firstName + " " + lastName,
      email, address, size, qty, garment, color,
      verse: currentVerse,
      style: selectedStyle,
      orderId: "CHO-" + Date.now().toString().slice(-6)
    };
    sessionStorage.setItem("chosenOrder", JSON.stringify(orderDetails));

    // Show success message then open Stripe in new tab
    document.getElementById("modalForm").style.display = "none";
    document.getElementById("modalSuccess").style.display = "block";

    const params = new URLSearchParams({ prefilled_email: email });
    setTimeout(() => {
      window.open(STRIPE_LINK + "?" + params.toString(), "_blank");
    }, 2200);
  }

  // Close modal on overlay click
  document.getElementById('orderModal').addEventListener('click', function(e) {
    if (e.target === this) closeOrderModal();
  });
</script>

